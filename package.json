        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@histoire/plugin-vue": "1.0.0-beta.1",
        "@luna-park/design": "link:..\\core\\packages\\design",
        "@luna-park/eslint-config": "^1.4.3",
        "@luna-park/plugin": "link:..\\core\\packages\\plugin",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "histoire": "1.0.0-beta.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-node": "^6.0.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vue-tsc": "^3.3.13"
    },
    "peerDependencies": {
        "@luna-park/design": "^1.2.0",
        "@nuxt/ui": "^4.11.0",
        "tailwindcss": "^4.1.17",
