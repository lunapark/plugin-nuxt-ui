{
    "name": "@luna-park/plugin-nuxt-ui",
    "version": "1.10.0",
    "private": false,
    "description": "Nuxt UI plugin for Luna Park",
    "keywords": [
        "luna-park",
        "plugin",
        "nuxt",
        "ui"
    ],
    "homepage": "https://luna-park.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/lunapark/plugin-nuxt-ui"
    },
    "author": {
        "name": "Luna Park",
        "url": "https://luna-park.app"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "module": "./dist/index.js",
    "files": [
        "dist/**",
        "src/logo.svg"
    ],
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "pnpm run build",
        "dev": "vite build --watch",
        "dev:story": "histoire dev",
        "preview": "luna-preview",
        "generate": "vite-node src/generate.ts",
        "update": "ncu -u --cooldown 1d"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.5",
        "@internationalized/date": "3.12.4",
        "@nuxt/ui": "^4.12.0",
        "@vueuse/core": "^15.0.0",
        "tailwindcss": "^4.3.5",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@histoire/plugin-vue": "1.0.0-beta.1",
        "@luna-park/design": "^1.7.0",
        "@luna-park/eslint-config": "^1.4.5",
        "@luna-park/plugin": "^2.3.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "histoire": "1.0.0-beta.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-node": "^6.0.0",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "@luna-park/design": "^1.7.0",
        "@nuxt/ui": "^4.11.0",
        "tailwindcss": "^4.1.17",
        "vue": "^3.5.24",
        "vue-router": "^4.6.3"
    }
}
