{
    "name": "@luna-park/plugin-nuxt-ui",
    "version": "1.4.0",
    "private": false,
    "description": "Nuxt UI plugin for Luna Park",
    "keywords": [
        "luna-park",
        "plugin",
        "nuxt",
        "ui"
    ],
    "homepage": "https://luna-park.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/lunapark/plugin-nuxt-ui"
    },
    "author": {
        "name": "Luna Park",
        "url": "https://luna-park.app"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "module": "./dist/index.js",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "preview": "luna-preview",
        "generate": "vite-node src/generate.ts",
        "update": "ncu -u --cooldown 1d"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@nuxt/ui": "^4.7.1",
        "@vueuse/core": "^14.3.0",
        "tailwindcss": "^4.2.4",
        "vue": "3.5.33",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@luna-park/eslint-config": "^1.2.6",
        "@luna-park/plugin": "link:..\\core\\packages\\plugin",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vite-node": "^6.0.0",
        "vue-tsc": "^3.2.8"
    },
    "peerDependencies": {
        "@nuxt/ui": "^4.3.0",
        "tailwindcss": "^4.1.17",
        "vue": "^3.5.24",
        "vue-router": "^4.6.3"
    }
}
